# ============================================================
# Combined environment variable reference for the whole
# integrated project. Each sub-project also has its own
# .env.example with the same variables scoped to that service —
# copy THAT file to .env/.env.local inside backend/ and frontend/
# respectively; this root file is just a single-page overview.
# ============================================================

# ---------------- backend/ (SmartRail backend) ----------------
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smartrail_twin
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
BROADCAST_INTERVAL_MS=5000
# FastAPI AI/ML engine base URL (ai-engine/, default port 8000)
AI_ENGINE_URL=http://localhost:8000
# Anthropic API key for the OCC advisory feature (replaces Gemini —
# see GEMINI_AUDIT.md). Leave blank to use the deterministic fallback.
ANTHROPIC_API_KEY=

# ---------------- frontend/ (RailFlow) -------------------------
# Base URL of the backend's REST API. Leave blank for local dev
# (Vite proxies same-origin /api to BACKEND_URL automatically).
VITE_API_URL=
BACKEND_URL=http://localhost:5000

# ---------------- ai-engine/ (SmartRail AI Engine) --------------
# No required env vars — model/report directories are resolved
# relative to the project root in app/config.py. Run
# `python scripts/train_all.py` before the /predict/* endpoints
# will return real predictions (see root README.md).
